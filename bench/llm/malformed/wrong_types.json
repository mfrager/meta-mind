{
  "name": "wrong_types",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "score"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "score": { "type": "integer", "minimum": 0, "maximum": 10 }
    }
  },
  "payload": "{\"name\": 5, \"score\": \"three\"}",
  "expect": "type_mismatch"
}
