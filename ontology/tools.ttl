# Tool execution vocabulary (Phase 10).
#
# The T-Box for `/tools`, the named graph `mm-tools` writes. It shares the `mm:`
# namespace with `mm.ttl` and only *adds* classes and properties, which is what
# `Config::ontology_tools_file` relies on: loading it cannot change the meaning of a
# graph that was already validated.
#
# What lives here: the tool contract (`mm:Tool`), the action record (`mm:Action`) and
# the execution-sourced observation (`mm:ActionObservation`).
#
# Why `mm:ActionObservation` and not `mm:Observation`: `mm:Observation` is already the
# RDF class of every epistemic claim of kind `Observation` — Phase 6's mirror types a
# claim node by its `ClaimKind` — so a shape requiring `mm:producedEvidence` on every
# `mm:Observation` would fire on the claims in `/epistemic` and `/world`. It is the same
# collision `ontology/shapes/decision.ttl` records for `mm:Decision`, handled the same
# way: a distinct class, and the reason written down.
#
# What does *not* live here, and why: the permission grants and the policy sets are not
# mirrored into RDF at all. `/tools` holds what an action *did*; the grant that allowed
# it and the rule that forbade it are rows in `permission_grants` / `policy_sets` with
# `CHECK` constraints of their own, and the audit record of the decision is the ledger
# (`action_ledger`), which is hash-chained and append-only. Mirroring them here would
# put the same fact in two stores with two lifetimes, and the graph would be the copy
# nobody scrolls back through.
#
# Namespaces: `mm:` is `https://metamind.dev/ontology#`, `prov:` is the PROV-O
# namespace. Every predicate below is emitted by `mm-tools::rdf`.

@prefix mm:    <https://metamind.dev/ontology#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .

# ------------------------------------------------------------------ classes --

mm:Tool a rdfs:Class ;
    rdfs:label "Tool" ;
    rdfs:comment """A registered tool: its name, its version, its reversibility, its
side-effect class, the isolation tier it runs under, and the capabilities it declares.
The exemplar is a module IRI under `https://metamind.dev/code/module/tools/`, so a tool
in the graph can be traced to the code that implements it.""" .

mm:Action a rdfs:Class ;
    rdfs:label "Action" ;
    rdfs:comment """One requested action and what became of it: the tool, the principal
that asked, the argument hash, the permission decision, the tier it ran in, and the
result. An action node is a *record*, not a request: it exists only after the executor
decided it.""" .

mm:ActionObservation a rdfs:Class ;
    rdfs:label "Action observation" ;
    rdfs:comment """Something the environment did, recorded from a tool call that ran.
Every instance carries exactly one `mm:producedEvidence` naming the Phase 6 evidence
id it stands on, which is what makes it admissible to `/world` as a claim and
unfabricatable from a plan.""" .

mm:KernelToolExecutor a mm:AgentLike ;
    rdfs:label "the kernel tool executor" ;
    rdfs:comment "The only agent that may produce an `mm:ActionObservation`." .

mm:ToolExecution a mm:ActivityLike ;
    rdfs:label "a tool execution" ;
    rdfs:comment "The PROV activity an action's observation was generated by." .

# `mm:AgentLike` and `mm:ActivityLike` are local stand-ins for `prov:Agent` and
# `prov:Activity`: declaring them here rather than importing PROV-O keeps the ontology
# loadable without a network fetch. The PROV-O terms are what the instance data
# actually uses (`prov:wasGeneratedBy`, `prov:wasStartedAtTime`).

mm:AgentLike a rdfs:Class .
mm:ActivityLike a rdfs:Class .

# -------------------------------------------------------------- properties --

mm:toolName a rdf:Property ;
    rdfs:label "tool name" ;
    rdfs:comment "The `namespace.verb` name of a tool, or the tool an action called." ;
    rdfs:domain mm:Tool ;
    rdfs:range xsd:string .

mm:version a rdf:Property ;
    rdfs:label "version" ;
    rdfs:comment "The tool contract's version. A schema or capability change needs one." ;
    rdfs:domain mm:Tool ;
    rdfs:range xsd:string .

mm:reversibility a rdf:Property ;
    rdfs:label "reversibility" ;
    rdfs:comment "`reversible`, `compensatable` or `irreversible`. An `irreversible` action needs an escalation before it runs." ;
    rdfs:range xsd:string .

mm:sideEffectClass a rdf:Property ;
    rdfs:label "side-effect class" ;
    rdfs:comment "`none`, `local`, `external` or `irreversible`." ;
    rdfs:range xsd:string .

mm:sandboxTier a rdf:Property ;
    rdfs:label "sandbox tier" ;
    rdfs:comment "`WasmCaps`, `Gvisor` or `MicroVm` — the isolation tier the tool declares." ;
    rdfs:range xsd:string .

mm:moduleUri a rdf:Property ;
    rdfs:label "module IRI" ;
    rdfs:comment "The module that implements the tool: `https://metamind.dev/code/module/tools/...`." ;
    rdfs:range xsd:string .

mm:hasCapability a rdf:Property ;
    rdfs:label "has capability" ;
    rdfs:comment """A capability the tool declares, in the canonical `kind:verb:pattern`
form (`fs:write:data/sandbox/**`). Declaring is not holding: the executor narrows this to
the intersection with the caller's grants before the tool runs.""" ;
    rdfs:range xsd:string .

mm:argsHash a rdf:Property ;
    rdfs:label "argument hash" ;
    rdfs:comment "sha256 of the canonical arguments. Two identical calls share it, which is what makes a retry comparable." ;
    rdfs:domain mm:Action ;
    rdfs:range xsd:string .

mm:performedBy a rdf:Property ;
    rdfs:label "performed by" ;
    rdfs:comment "The principal an action was performed by or for. Every action names one, so a tool can never act with wider rights than its caller." ;
    rdfs:range xsd:string .

mm:permissionDecision a rdf:Property ;
    rdfs:label "permission decision" ;
    rdfs:comment "`allow`, `deny` or `escalate`, from the deterministic permission engine." ;
    rdfs:domain mm:Action ;
    rdfs:range xsd:string .

mm:status a rdf:Property ;
    rdfs:label "status" ;
    rdfs:comment "`ok`, `error`, `denied`, `timeout` or `deduplicated`." ;
    rdfs:range xsd:string .

mm:resultHash a rdf:Property ;
    rdfs:label "result hash" ;
    rdfs:comment "A hash of the action's outcome, so two runs of the same action are comparable." ;
    rdfs:range xsd:string .

mm:refusalReason a rdf:Property ;
    rdfs:label "refusal reason" ;
    rdfs:comment "Why an action was refused, in one sentence." ;
    rdfs:range xsd:string .

mm:observedIn a rdf:Property ;
    rdfs:label "observed in" ;
    rdfs:comment "The named graph an observation was recorded in. Exactly one per observation." ;
    rdfs:domain mm:ActionObservation ;
    rdfs:range rdfs:Resource .

mm:resultedIn a rdf:Property ;
    rdfs:label "resulted in" ;
    rdfs:comment "The action an observation came from." ;
    rdfs:domain mm:ActionObservation ;
    rdfs:range mm:Action .

mm:producedEvidence a rdf:Property ;
    rdfs:label "produced evidence" ;
    rdfs:comment """The Phase 6 evidence id an observation stands on. Exactly one, and it is
required: an observation with no execution evidence cannot be admitted to `/world`, so
the barrier would refuse its claim.""" ;
    rdfs:domain mm:ActionObservation ;
    rdfs:range rdfs:Resource .

mm:observedBy a rdf:Property ;
    rdfs:label "observed by" ;
    rdfs:comment "The agent that observed it. Always the kernel tool executor: an observation is never attributed to a model." ;
    rdfs:domain mm:ActionObservation ;
    rdfs:range mm:AgentLike .

mm:source a rdf:Property ;
    rdfs:label "source" ;
    rdfs:comment "The concrete endpoint that was reached, as `kind:endpoint`." ;
    rdfs:range xsd:string .

mm:payloadHash a rdf:Property ;
    rdfs:label "payload hash" ;
    rdfs:comment "A hash of the observation's payload, which is what the `/world` claim asserts." ;
    rdfs:range xsd:string .

mm:summary a rdf:Property ;
    rdfs:label "summary" ;
    rdfs:comment "One sentence from the tool's own outcome." ;
    rdfs:range xsd:string .

mm:observedAt a rdf:Property ;
    rdfs:label "observed at" ;
    rdfs:comment "When it was observed, RFC3339." ;
    rdfs:range xsd:string .

mm:reversedBy a rdf:Property ;
    rdfs:label "reversed by" ;
    rdfs:comment "The snapshot or compensating action that undid an action. Emitted once `action rollback` has restored a byte-identical state." ;
    rdfs:range rdfs:Resource .

mm:verifiedBy a rdf:Property ;
    rdfs:label "verified by" ;
    rdfs:comment "The proof a verification obligation was discharged by." ;
    rdfs:range rdfs:Resource .

prov:wasStartedAtTime a rdf:Property .
prov:wasGeneratedBy a rdf:Property .
prov:wasInvalidatedBy a rdf:Property .
