# Metamind LLM vocabulary — the `mm:` terms for the inference call ledger.
#
# Phase 3 gives every call one accountable record. `llm_calls` in the tabular store
# is the audit trail, the `/provenance` graph is its RDF projection, and this file
# declares the vocabulary both speak. The terms join the `mm:` namespace beside the
# Phase 1 T-Box, so a caller never has to learn a second set of names for "a call
# that happened".
#
# This is plain Turtle. It is parsed by the vendored `rdf-codec` reader when the
# kernel loads its ontology, so it carries no SHACL constructs, no blank nodes, and
# no OWL class expressions. Constraints live in `ontology/shapes/`.

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix mm:   <https://metamind.dev/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

mm: a owl:Ontology ;
    rdfs:label "Metamind LLM vocabulary" ;
    rdfs:comment "Classes and properties of the LLM call ledger: what a call was, what it cost, and which decoder produced it." ;
    owl:versionInfo "0.3.0" .

# --- classes -----------------------------------------------------------------

mm:LlmCall a owl:Class ;
    rdfs:label "LLM call" ;
    rdfs:comment "One inference call, recorded whether it succeeded, was cached, was rejected, or failed." .

mm:LlmRequest a owl:Class ;
    rdfs:label "LLM request" ;
    rdfs:comment "The provider-neutral request a call was made from." .

mm:LlmSchema a owl:Class ;
    rdfs:label "LLM schema" ;
    rdfs:comment "A strict JSON Schema a structured call's output had to satisfy." .

mm:LlmGrammar a owl:Class ;
    rdfs:label "LLM grammar" ;
    rdfs:comment "A grammar compiled from a schema, cached by schema hash." .

mm:LlmRoute a owl:Class ;
    rdfs:label "LLM route" ;
    rdfs:comment "A router's decision: which model was selected, and why." .

# --- object properties -------------------------------------------------------

mm:calledWith a owl:ObjectProperty ;
    rdfs:label "called with" ;
    rdfs:comment "The schema a structured call's output had to satisfy." ;
    rdfs:domain mm:LlmCall ;
    rdfs:range mm:LlmSchema .

mm:usedGrammar a owl:ObjectProperty ;
    rdfs:label "used grammar" ;
    rdfs:comment "The compiled grammar the decoder constrained generation with." ;
    rdfs:domain mm:LlmCall ;
    rdfs:range mm:LlmGrammar .

mm:routedTo a owl:ObjectProperty ;
    rdfs:label "routed to" ;
    rdfs:comment "The routing decision that chose the model this call used." ;
    rdfs:domain mm:LlmCall ;
    rdfs:range mm:LlmRoute .

mm:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "was generated by" ;
    rdfs:comment "The activity that produced this call, narrowing prov:wasGeneratedBy to the LLM substrate." ;
    rdfs:subPropertyOf prov:wasGeneratedBy .

# --- datatype properties -----------------------------------------------------

mm:promptHash a owl:DatatypeProperty ;
    rdfs:label "prompt hash" ;
    rdfs:comment "sha256 over the canonical request; the cache key and the replay key." ;
    rdfs:range xsd:string .

mm:tokensIn a owl:DatatypeProperty ;
    rdfs:label "tokens in" ;
    rdfs:comment "Prompt tokens billed." ;
    rdfs:range xsd:integer .

mm:tokensOut a owl:DatatypeProperty ;
    rdfs:label "tokens out" ;
    rdfs:comment "Completion tokens billed." ;
    rdfs:range xsd:integer .

mm:costMicros a owl:DatatypeProperty ;
    rdfs:label "cost micros" ;
    rdfs:comment "The call's cost in millionths of a currency unit." ;
    rdfs:range xsd:integer .

mm:latencyMs a owl:DatatypeProperty ;
    rdfs:label "latency ms" ;
    rdfs:comment "Wall-clock latency of the call in milliseconds." ;
    rdfs:range xsd:integer .

mm:decoder a owl:DatatypeProperty ;
    rdfs:label "decoder" ;
    rdfs:comment "Which decoder produced the output: llguidance | xgrammar | provider_native | none." ;
    rdfs:range xsd:string .

mm:purpose a owl:DatatypeProperty ;
    rdfs:label "purpose" ;
    rdfs:comment "Why the call was made; the axis the ledger aggregates on." ;
    rdfs:range xsd:string .

mm:cached a owl:DatatypeProperty ;
    rdfs:label "cached" ;
    rdfs:comment "True when the answer came from a cache rather than a provider." ;
    rdfs:range xsd:boolean .

mm:model a owl:DatatypeProperty ;
    rdfs:label "model" ;
    rdfs:comment "The model that actually answered." ;
    rdfs:range xsd:string .

mm:provider a owl:DatatypeProperty ;
    rdfs:label "provider" ;
    rdfs:comment "The provider adapter that answered, or was asked." ;
    rdfs:range xsd:string .

mm:callStatus a owl:DatatypeProperty ;
    rdfs:label "call status" ;
    rdfs:comment "How the call ended: ok | schema_rejected | provider_error | timeout | replay." ;
    rdfs:range xsd:string .
