# Session, conversation-state, work, and frame vocabulary (Phase 0).
#
# The session is an RDF resource. Traces are manifests over agentstream
# segments, not duplicate event stores. No instance data is asserted here.

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix mm:   <https://metamind.dev/ontology#> .
@prefix mmd:  <https://metamind.dev/data/> .
@prefix mmg:  <https://metamind.dev/graph/> .

mm:Session a owl:Class ;
    rdfs:label "Session" ;
    rdfs:comment "One durable conversation session with lifecycle, presence, work, and traces." .
mm:SessionTrace a owl:Class ;
    rdfs:label "SessionTrace" ;
    rdfs:comment "A trace manifest over an agentstream segment." .
mm:ConversationState a owl:Class ;
    rdfs:label "ConversationState" ;
    rdfs:comment "One topic, one depth, and a bounded typed status dictionary." .
mm:StatusVariable a owl:Class ;
    rdfs:label "StatusVariable" .
mm:WorkItem a owl:Class ;
    rdfs:label "WorkItem" .
mm:ConversationFrame a owl:Class ;
    rdfs:label "ConversationFrame" .
mm:FrameUtterance a owl:Class ;
    rdfs:label "FrameUtterance" .
mm:FrameStack a owl:Class ;
    rdfs:label "FrameStack" ;
    rdfs:comment "The bounded root-to-top conversation frame stack." .

# --- session ----------------------------------------------------------------
mm:sessionId a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:string .
mm:userId a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:string .
mm:lifecycle a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:string .
mm:presence a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:string .
mm:openedAt a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:integer .
mm:lastActivityAt a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:integer .
mm:lastUserInputAt a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
mm:lastWorkActivityAt a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
mm:lastClientSeenAt a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
mm:expiresAt a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
mm:endedAt a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
mm:endReason a owl:DatatypeProperty ;
    rdfs:range xsd:string .
mm:sessionDir a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:string .
mm:hasTrace a owl:ObjectProperty ;
    rdfs:domain mm:Session ;
    rdfs:range mm:SessionTrace .
mm:mainTrace a owl:ObjectProperty ;
    rdfs:domain mm:Session ;
    rdfs:range mm:SessionTrace .
mm:supersededBy a owl:ObjectProperty ;
    rdfs:domain mm:Session ;
    rdfs:range mm:Session .
mm:resumeEpoch a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:integer .
mm:resumeOf a owl:ObjectProperty ;
    rdfs:domain mm:Session ;
    rdfs:range mm:Session .
mm:resumeCount a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:integer .
mm:deletedAt a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
mm:deletedBy a owl:DatatypeProperty ;
    rdfs:range xsd:string .
mm:workItem a owl:ObjectProperty ;
    rdfs:domain mm:Session ;
    rdfs:range mm:WorkItem .
mm:frameStackRevision a owl:DatatypeProperty ;
    rdfs:domain mm:Session ;
    rdfs:range xsd:integer .
mm:hasFrame a owl:ObjectProperty ;
    rdfs:domain mm:Session ;
    rdfs:range mm:ConversationFrame .
mm:pendingUtterance a owl:ObjectProperty ;
    rdfs:domain mm:Session ;
    rdfs:range mm:FrameUtterance .

# --- trace manifest ---------------------------------------------------------
mm:traceId a owl:DatatypeProperty ;
    rdfs:domain mm:SessionTrace ;
    rdfs:range xsd:string .
mm:agentstreamId a owl:DatatypeProperty ;
    rdfs:domain mm:SessionTrace ;
    rdfs:range xsd:string .
mm:traceKind a owl:DatatypeProperty ;
    rdfs:domain mm:SessionTrace ;
    rdfs:range xsd:string .
mm:firstSeq a owl:DatatypeProperty ;
    rdfs:domain mm:SessionTrace ;
    rdfs:range xsd:integer .
mm:lastSeq a owl:DatatypeProperty ;
    rdfs:domain mm:SessionTrace ;
    rdfs:range xsd:integer .
mm:eventCount a owl:DatatypeProperty ;
    rdfs:domain mm:SessionTrace ;
    rdfs:range xsd:integer .
mm:startedAt a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
mm:sizeBytes a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

# --- conversation state -----------------------------------------------------
mm:topic a owl:DatatypeProperty ;
    rdfs:domain mm:ConversationState ;
    rdfs:range xsd:string .
mm:depth a owl:DatatypeProperty ;
    rdfs:domain mm:ConversationState ;
    rdfs:range xsd:integer .
mm:statusVariable a owl:ObjectProperty ;
    rdfs:domain mm:ConversationState ;
    rdfs:range mm:StatusVariable .
mm:statusKey a owl:DatatypeProperty ;
    rdfs:domain mm:StatusVariable ;
    rdfs:range xsd:string .
mm:statusValue a owl:DatatypeProperty ;
    rdfs:domain mm:StatusVariable ;
    rdfs:range xsd:string .
mm:updatedAt a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
mm:updatedBy a owl:DatatypeProperty ;
    rdfs:range xsd:string .

# --- work catalog -----------------------------------------------------------
mm:workId a owl:DatatypeProperty ;
    rdfs:domain mm:WorkItem ;
    rdfs:range xsd:string .
mm:workTitle a owl:DatatypeProperty ;
    rdfs:domain mm:WorkItem ;
    rdfs:range xsd:string .
mm:workKind a owl:DatatypeProperty ;
    rdfs:domain mm:WorkItem ;
    rdfs:range xsd:string .
mm:workStatus a owl:DatatypeProperty ;
    rdfs:domain mm:WorkItem ;
    rdfs:range xsd:string .
mm:sourceRef a owl:DatatypeProperty ;
    rdfs:domain mm:WorkItem ;
    rdfs:range xsd:string .
mm:interjectionPolicy a owl:DatatypeProperty ;
    rdfs:domain mm:WorkItem ;
    rdfs:range xsd:string .

# --- frames -----------------------------------------------------------------
mm:frameId a owl:DatatypeProperty ;
    rdfs:domain mm:ConversationFrame ;
    rdfs:range xsd:string .
mm:templateId a owl:DatatypeProperty ;
    rdfs:domain mm:ConversationFrame ;
    rdfs:range xsd:string .
mm:templateVersion a owl:DatatypeProperty ;
    rdfs:domain mm:ConversationFrame ;
    rdfs:range xsd:integer .
mm:frameKind a owl:DatatypeProperty ;
    rdfs:domain mm:ConversationFrame ;
    rdfs:range xsd:string .
mm:frameStatus a owl:DatatypeProperty ;
    rdfs:domain mm:ConversationFrame ;
    rdfs:range xsd:string .
mm:enteredAt a owl:DatatypeProperty ;
    rdfs:domain mm:ConversationFrame ;
    rdfs:range xsd:integer .
mm:utteranceId a owl:DatatypeProperty ;
    rdfs:domain mm:FrameUtterance ;
    rdfs:range xsd:string .
mm:frameIdRef a owl:DatatypeProperty ;
    rdfs:domain mm:FrameUtterance ;
    rdfs:range xsd:string .
mm:dueAt a owl:DatatypeProperty ;
    rdfs:domain mm:FrameUtterance ;
    rdfs:range xsd:integer .
mm:utteranceReason a owl:DatatypeProperty ;
    rdfs:domain mm:FrameUtterance ;
    rdfs:range xsd:string .
mm:attempt a owl:DatatypeProperty ;
    rdfs:domain mm:FrameUtterance ;
    rdfs:range xsd:integer .
