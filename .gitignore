/target
/data
/data/**
!/data/.gitkeep
**/*.rs.bk
Cargo.lock.orig
.DS_Store
/reports

# Phase 2: the per-module metadata is generated by `mm-cli codex scan` and is
# deterministic, so it is not committed. registry.json and codex.lock are.
/modules/**/metadata.ttl

# Phase 11: a regression case's subject is written by its own `reset.sh`/`fix.sh`, so it
# is state, not source. The case's `case.json` and its three scripts are committed.
/bench/regression/*/subject.sh
