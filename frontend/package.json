{
  "name": "metamind-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundle-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && node scripts/lint-radius.mjs",
    "lint:radius": "node scripts/lint-radius.mjs",
    "test": "vitest run",
    "test:replay": "vitest run src/lib/transcript/reducer.test.tsx",
    "test:e2e": "TMPDIR=\"${TMPDIR:-$HOME/tmp}\" playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,css}\""
  },
  "dependencies": {
