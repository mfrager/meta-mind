# llguidance grammar for schema `extract.v1` (sha256 81704796c452)
# generated by mm-llm from the registered strict schema; do not edit
root__root__name ::= "\"" [^"]{1,} "\""  # constraint minLength=1
root__root__score ::= int  # constraint minimum=0 maximum=10
root__root ::= "{" ws "\"name\"" ws ":" ws root__root__name ws "," ws "\"score\"" ws ":" ws root__root__score ws "}"
